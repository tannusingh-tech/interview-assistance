# Copy this file to ".env" in the project root (same folder as this file).
# The real ".env" is git-ignored. Never commit real values.
# Speech-to-text runs locally (faster-whisper) and needs no key. Only the OpenRouter key below is a secret.

# --- Backend (FastAPI) ---
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API and open the WebSocket.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Local speech-to-text (faster-whisper) ---
# Model: tiny | base | small | medium ... (add ".en" for English-only, e.g. base.en),
# or a path to a local model folder. Larger = more accurate but slower.
WHISPER_MODEL=base
# cpu | cuda | auto. Use cpu unless you have a CUDA-capable NVIDIA GPU set up.
WHISPER_DEVICE=cpu
# int8 is the right choice for CPU. On a CUDA GPU use float16.
WHISPER_COMPUTE_TYPE=int8
# Spoken language code (en, es, de, ...). Leave blank to auto-detect (less stable on short chunks).
WHISPER_LANGUAGE=en
# 1 = fastest. Higher values are slightly more accurate and slower.
WHISPER_BEAM_SIZE=1
# Skip silence before transcribing. Reduces made-up text during pauses.
WHISPER_VAD_FILTER=true
# 0 = let the library decide.
WHISPER_CPU_THREADS=0
# Where models are downloaded. Blank = default Hugging Face cache (~/.cache/huggingface).
WHISPER_MODEL_DIR=
# Seconds of the previous chunk re-fed to the next one so words on a boundary are not cut.
AUDIO_OVERLAP_SECONDS=1.0
# Backlog limit: if transcription falls behind, the oldest waiting chunk is dropped.
MAX_PENDING_CHUNKS=6

# --- Question detection ---
# The same question is ignored if it is detected again within this many seconds.
QUESTION_DEDUPE_SECONDS=60

# --- AI answers via OpenRouter (backend only; this key is never sent to the browser) ---
# Create a key at https://openrouter.ai/keys and paste it here. Never commit it.
OPENROUTER_API_KEY=
# "openrouter/free" lets OpenRouter pick any currently available free model. Free models change,
# so if one is unavailable, pick another from https://openrouter.ai/models?pricing=free
# (for example a specific "...:free" id) or use a paid model id.
OPENROUTER_MODEL=openrouter/free
# Seconds to wait for the provider before giving up (it resets as text arrives).
OPENROUTER_TIMEOUT_SECONDS=30
# Upper bound on answer length (about 350 tokens is roughly 250 words).
OPENROUTER_MAX_TOKENS=350
# Retries for HTTP 429/502/503/504, only before any text has arrived. 0 disables.
OPENROUTER_MAX_RETRIES=1
# Set to false if a model rejects system messages ("developer instruction is not enabled").
OPENROUTER_USE_SYSTEM_ROLE=true
# Max characters of resume / job description sent to the model (each).
ANSWER_MAX_CONTEXT_CHARS=8000

# --- Frontend (Vite) ---
# Only variables prefixed with VITE_ reach the browser. Never put secrets behind VITE_.
VITE_API_BASE_URL=http://localhost:8000
# Length of each audio chunk in milliseconds. 2500ms provides optimal latency for the <3s target.
VITE_AUDIO_CHUNK_MS=2500
